<Window x:Class="VoiceCheck.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Voice Check" Width="188" Height="34" WindowStyle="None"
    AllowsTransparency="True" Background="Transparent" Topmost="True"
    ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
    PreviewKeyDown="OnKeyDown">
  <Grid>
    <Grid x:Name="PillTarget" Width="110" Height="34" HorizontalAlignment="Left"
          Background="Transparent" Cursor="Hand" Focusable="True"
          AutomationProperties.Name="Start or stop system listening; drag to move"
          MouseLeftButtonDown="OnPointerDown" MouseMove="OnPointerMove" MouseLeftButtonUp="OnPointerUp"
          MouseEnter="OnHover" MouseLeave="OnHover" LostMouseCapture="OnLostCapture">
      <Border x:Name="Pill" Width="40" Height="8" CornerRadius="18" BorderThickness="1"
              BorderBrush="#80FFFFFF" Background="#80000000" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas x:Name="Mark" Width="90" Height="18" Visibility="Collapsed">
          <Ellipse x:Name="LeftAction" Canvas.Left="1" Canvas.Top="1" Width="16" Height="16" Fill="#414140" />
          <Path x:Name="LeftGlyph" Data="M6,6 L12,12 M12,6 L6,12" Stroke="#DEDDD7" StrokeThickness="1.4" />
          <StackPanel x:Name="Bars" Orientation="Horizontal" Canvas.Left="29" Height="18" VerticalAlignment="Center" />
          <Ellipse x:Name="RightAction" Canvas.Left="73" Canvas.Top="1" Width="16" Height="16" Fill="#EEEAE2" />
          <Path x:Name="RightGlyph" Data="M77.5,9 L79.7,11.2 L84,6.8" Stroke="#151515" StrokeThickness="1.5" />
        </Canvas>
      </Border>
    </Grid>
    <Border x:Name="Badge" HorizontalAlignment="Left" Margin="114,6,0,0" VerticalAlignment="Top"
            Height="22" MaxWidth="74" CornerRadius="11" Background="#191919" BorderThickness="1"
            BorderBrush="#22FFFFFF" Visibility="Collapsed">
      <TextBlock x:Name="BadgeText" Foreground="#C9C8C3" FontFamily="Segoe UI" FontSize="10"
                 Padding="7,2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
